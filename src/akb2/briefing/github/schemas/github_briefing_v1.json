{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "github_briefing_v1",
  "title": "github_briefing_v1",
  "description": "GitHub 高热项目日推简报 schema v1 — vault 写入产物的机器可读结构",
  "type": "object",
  "required": [
    "schema_version",
    "briefing_type",
    "generated_at",
    "date",
    "candidate_pool_size",
    "active_curators_today",
    "fallback_layer_used",
    "top_repos"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "briefing_type": {
      "const": "github-curator"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "简报生成时刻 ISO 8601"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "简报覆盖的日期（YYYY-MM-DD）"
    },
    "candidate_pool_size": {
      "type": "integer",
      "minimum": 0,
      "description": "候选池总人数（config/github_curator_pool.yaml 的 handle 数）"
    },
    "active_curators_today": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^@\\w+$"
      },
      "description": "今日有原创 + 含 github URL 推文的博主清单"
    },
    "fallback_layer_used": {
      "enum": ["layer1", "layer2", "layer3"],
      "description": "实际触发的兜底层级；layer1 = X curator 主路径；layer2 = GitHub Trending HTML；layer3 = 人工 JSON 注入"
    },
    "top_repos": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "description": "今日 top 10 项目，长度严格 = 10；不足时 pipeline 写 briefing-skipped.json 不落本文件",
      "items": {
        "type": "object",
        "required": [
          "repo_url",
          "stars",
          "language",
          "topic_tags",
          "mention_count",
          "mentioners",
          "first_mention_at",
          "score",
          "summary",
          "use_case"
        ],
        "additionalProperties": false,
        "properties": {
          "repo_url": {
            "type": "string",
            "pattern": "^https://github\\.com/[\\w.-]+/[\\w.-]+$",
            "description": "已 url_normalizer 归一化（lowercase + 剥尾巴 + 无 .git）"
          },
          "stars": {
            "type": "integer",
            "minimum": 0
          },
          "language": {
            "type": ["string", "null"],
            "description": "GitHub API 返回的主语言；可为 null"
          },
          "topic_tags": {
            "type": "array",
            "items": {"type": "string"}
          },
          "mention_count": {
            "type": "integer",
            "minimum": 1
          },
          "mentioners": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^@\\w+$"
            },
            "description": "Layer 2 兜底时为 [\"@github_trending\"]；Layer 3 由用户自填"
          },
          "first_mention_at": {
            "type": "string",
            "format": "date-time"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "6 维加权 [0,1]；冷启动期 stars_velocity 不参与"
          },
          "summary": {
            "type": "string",
            "minLength": 50,
            "maxLength": 500,
            "description": "项目做什么 — 200 字以内中文，客观陈述功能/技术栈/解决的问题，由 DeepSeek V4 Pro 生成"
          },
          "use_case": {
            "type": "string",
            "minLength": 30,
            "maxLength": 300,
            "description": "什么情况下该装 + 什么情况下别装 — 中文，含 1-2 条正向场景 + 1 条反向场景，由 DeepSeek V4 Pro 生成"
          },
          "engagement_raw": {
            "type": "integer",
            "minimum": 0,
            "description": "该 repo 最热单条提及的加权推文热度；layer2/3 或无 metrics = 0"
          }
        }
      }
    }
  }
}
