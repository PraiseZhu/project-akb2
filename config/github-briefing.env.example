# GitHub Curator Briefing — environment variables
#
# SETUP:
#   1. cp config/github-briefing.env.example ~/.config/akb2/github-briefing.env
#   2. chmod 600 ~/.config/akb2/github-briefing.env
#   3. Fill in values below
#
# This file is a template. The real file lives at ~/.config/akb2/github-briefing.env
# and is NEVER committed to git.

# Absolute path to Obsidian vault root (REQUIRED)
# Example: /Users/praise/Library/Mobile Documents/iCloud~md~obsidian/Documents/AKB
VAULT_ROOT=

# AI Gateway key for synthesis (REQUIRED) — 全局所有链路统一走 AI Gateway
# (llm-proxy.tapsvc.com, OpenAI 兼容)，不直连各家 provider。
# 变量名二选一：部署侧约定 AI_GATEWAY_API_KEY；本机运行时已设 DEEPSEEK_API_KEY（同一 Gateway key）。
# synthesis 优先读 AI_GATEWAY_API_KEY，回退 DEEPSEEK_API_KEY。
AI_GATEWAY_API_KEY=
# Gateway base URL（可选，留空则默认 https://llm-proxy.tapsvc.com）。
# 同样支持 DEEPSEEK_BASE_URL（本机运行时变量名）。
AI_GATEWAY_BASE_URL=

# GitHub Personal Access Token (REQUIRED for enrichment)
# Create at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_PAT=