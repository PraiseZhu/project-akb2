<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AKB2 intake-twitter 抓取链路 — X 账号源独立定时器

  ==== 安装 ====
  ⚠️ 本文件含 __AKB2_REPO_ROOT__ / __AKB2_VAULT_ROOT__ / __AKB2_HOME__ 占位符,
     不要直接 launchctl bootstrap/load 本模板(会加载未渲染的占位符路径)。
     用 scripts/bootstrap_intake_launchd.sh 同款渲染后再加载。
     宪法「新增自动化触发器必须人工确认」——本 plist 只是文件,未自行 bootstrap。

  # 卸载(对已渲染加载的服务):
  launchctl bootout gui/$(id -u)/com.akb2.intake-twitter

  # 查看状态:
  launchctl list | grep com.akb2.intake-twitter

  ==== 触发时间 ====
  每 15 分钟一次(StartInterval=900s),与 RSS intake 对齐但不共享 limit。

  ==== 有界(宪法 P1) ====
  limit=20 (ProgramArguments 带 limit 20) 每次最多抓 20 篇 X 源,
  RSS 默认 com.akb2.intake limit 30 不被挤占。

  ==== 路径 ====
  sources:      __AKB2_REPO_ROOT__/config/main_sources.yaml
  output-dir:   __AKB2_VAULT_ROOT__/Praise Space/AKB2.0/raw
  state-file:   __AKB2_REPO_ROOT__/reports/intake/intake-twitter-state.jsonl
                (独立账本,绝不与 RSS intake-state.jsonl 混写)
  failures-path: __AKB2_REPO_ROOT__/logs/intake-twitter-failures.jsonl

  ==== 日志 ====
  stdout/stderr 重定向到 logs/intake-twitter.log

  ==== 用户授权 ====
  用户新增自动化触发器已明确批准(宪法"新增自动化触发器必须人工确认"已满足)。
  RunAtLoad=false——首跑由 lead 装载后手动 kickstart 验证,不搞装载即自动跑。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.akb2.intake-twitter</string>

    <key>ProgramArguments</key>
    <array>
        <string>__AKB2_HOME__/.pyenv/shims/python3</string>
        <string>-m</string>
        <string>akb2.quality.intake.orchestrator</string>
        <string>--sources-config</string>
        <string>__AKB2_REPO_ROOT__/config/main_sources.yaml</string>
        <string>--state-file</string>
        <string>__AKB2_REPO_ROOT__/reports/intake/intake-twitter-state.jsonl</string>
        <string>--output-dir</string>
        <string>__AKB2_VAULT_ROOT__/Praise Space/AKB2.0/raw</string>
        <string>--failures-path</string>
        <string>__AKB2_REPO_ROOT__/logs/intake-twitter-failures.jsonl</string>
        <string>--limit</string>
        <string>20</string>
        <string>--source-type</string>
        <string>x_account</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__AKB2_REPO_ROOT__</string>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__AKB2_REPO_ROOT__/logs/intake-twitter.log</string>

    <key>StandardErrorPath</key>
    <string>__AKB2_REPO_ROOT__/logs/intake-twitter.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>__AKB2_REPO_ROOT__/src</string>
        <key>PATH</key>
        <string>__AKB2_HOME__/.pyenv/shims:__AKB2_HOME__/.pyenv/bin:__AKB2_HOME__/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>AKB2_VAULT_ROOT</key>
        <string>__AKB2_VAULT_ROOT__/Praise Space/AKB2.0</string>
        <key>AKB2_INTAKE_SOURCE_TYPE</key>
        <string>x_account</string>
    </dict>
</dict>
</plist>
