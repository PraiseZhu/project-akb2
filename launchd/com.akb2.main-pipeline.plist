<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AKB2 主链路 quality runner — 24h 常驻串行单工 daemon

  ==== 安装 ====
  ⚠️ 本文件含 __AKB2_REPO_ROOT__ / __AKB2_VAULT_ROOT__ / __AKB2_HOME__ 占位符,
     不要直接 launchctl bootstrap/load 本模板(会加载未渲染的占位符路径)。
     用 scripts/deploy-mac-mini.sh 渲染到 ~/Library/LaunchAgents 后加载。

  # 卸载(对已渲染加载的服务):
  launchctl bootout gui/$(id -u)/com.akb2.main-pipeline

  # 查看状态:
  launchctl list | grep com.akb2.main-pipeline

  ==== 三链路触发时间对照表 (CST, UTC+8) ====
  | 链路              | Label                           | 触发时间 (CST) | 触发时间 (UTC) | AVOID_WINDOW (UTC ±15min) |
  | github_briefing   | com.akb2.github_briefing        | 05:30          | 21:30 (前日)   | 21:15 - 21:45             |
  | briefing          | com.akb2.briefing               | 07:30          | 23:30 (前日)   | 23:15 - 23:45             |
  | feishu-sync       | com.akb2.feishu-sync            | 11:15          | 03:15          | 03:00 - 03:30             |
  | main-pipeline     | com.akb2.main-pipeline          | 常驻 (KeepAlive)| N/A           | 三窗口内暂停取新队列      |

  避让规则: 在以上三个 AVOID_WINDOW 内，runner 暂停从 raw 目录取新队列，
  但在处理中的单篇做完不中断。

  ==== 环境变量 ====
  AKB2_AUTO_PROMOTE=1  — 自动升格：五闸 PASS 后直接写 active 页到
                         vault_root/wiki/sources/<slug>.md（promote.py 读该变量）。
                         2026-08-03 由 owner 确认：运行态自 2026-07-04 起即为 1，
                         本模板此前一直是 0，导致 smoke_validator 默认校验模板时
                         出具「proposal 模式」的通过证明，而 daemon 实际在自动写
                         active 知识（一个月 66 篇，均合规过闸）。现对齐运行态。
                         改回 0 会退回 proposal-only（只写 manifest，不写 active 页）。
  PYTHONPATH           — 指向 src/ 目录
  AKB2_VAULT_ROOT      — vault AKB2.0 根目录（从 vault.toml 解析的绝对路径）

  ==== 日志 ====
  stdout/stderr 重定向到 logs/akb2-quality-runner.log

  ==== 注意事项 ====
  - 路径用占位符(__AKB2_REPO_ROOT__ / __AKB2_VAULT_ROOT__ / __AKB2_HOME__),
    由 scripts/deploy-mac-mini.sh 渲染后原子写入 ~/Library/LaunchAgents 并 bootstrap 加载
  - runner 硬依赖: Python ≥ 3.11、LLM key env(~/.config/akb2/github-briefing.env)、
    openai / jsonschema / pyyaml;scrapling/playwright/defuddle 仅 intake 链路用(软依赖)
  - 跑飞保护: 单实例锁 (scripts/akb2-main-pipeline.sh)，无 while True 内层无限
  - 启动前运行时 vault 门: AKB2_VAULT_ROOT 缺/不可写即 FATAL 退出(KeepAlive 重试,不静默空跑)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.akb2.main-pipeline</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__AKB2_REPO_ROOT__/scripts/akb2-main-pipeline.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__AKB2_REPO_ROOT__</string>

    <key>KeepAlive</key>
    <true/>

    <!-- KeepAlive 已隐含加载即拉起;显式 true 仅为语义清晰。部署脚本不再 kickstart,
         验收以 bootstrap 后 launchctl print 的 state/PID + 日志信号
         (runner starting / grader_key / vault gate: ok)为准。 -->
    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>__AKB2_REPO_ROOT__/logs/akb2-quality-runner.log</string>

    <key>StandardErrorPath</key>
    <string>__AKB2_REPO_ROOT__/logs/akb2-quality-runner.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>AKB2_AUTO_PROMOTE</key>
        <string>1</string>
        <key>AKB2_AMENDMENT_APPLIED</key>
        <string>0</string>
        <key>AKB2_MAKER_FALLBACK</key>
        <string>1</string>
        <key>PYTHONPATH</key>
        <string>__AKB2_REPO_ROOT__/src</string>
        <key>PATH</key>
        <string>__AKB2_HOME__/.pyenv/shims:__AKB2_HOME__/.pyenv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>AKB2_VAULT_ROOT</key>
        <string>__AKB2_VAULT_ROOT__/Praise Space/AKB2.0</string>
    </dict>
</dict>
</plist>
