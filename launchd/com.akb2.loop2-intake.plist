<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AKB2 loop2 X intake — 4h×6 轮抓 X 三通道落 raw-loop2

  ==== 安装 ====
  本文件含 __AKB2_REPO_ROOT__ / __AKB2_VAULT_ROOT__ / __AKB2_HOME__ 占位符,
  不要直接 launchctl bootstrap 本模板。owner 2026-09-01 批准 Mini 通电。

    bash scripts/bootstrap_launchd.sh --plist-src launchd/com.akb2.loop2-intake.plist

  首跑验证（RunAtLoad=false，不装载即自动跑）:
    launchctl kickstart -p "gui/$(id -u)/com.akb2.loop2-intake"

  # 卸载：
  launchctl bootout gui/$(id -u)/com.akb2.loop2-intake
  # 查看状态：
  launchctl list | grep com.akb2.loop2-intake

  ==== 触发时间 ====
  StartInterval=14400（4 小时），约 6 轮/天。与 loop1 intake（900s）错开，
  不共享 raw 目录（本链路写 vault/raw-loop2，loop1 写 vault/raw）。

  ==== 有界（宪法 P1）====
  通道 cap 在 config/x_sources.yaml + intake_x.sources 常量
  （X_PER_CHANNEL_PER_RUN_CAP / X_BOOKMARKS_PER_RUN_CAP /
  X_PREFILTER_MAX_BATCHES_PER_RUN）。无 while True。

  ==== 路径 ====
  sources:      __AKB2_REPO_ROOT__/config/x_sources.yaml
  output-dir:   __AKB2_VAULT_ROOT__/Praise Space/AKB2.0/raw-loop2
  state-file:   __AKB2_REPO_ROOT__/reports/intake/loop2-intake-state.jsonl
  vault-root:   __AKB2_VAULT_ROOT__/Praise Space/AKB2.0（跨 loop duplicate_source）

  ==== 日志 ====
  stdout/stderr 重定向到 logs/loop2-intake.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.akb2.loop2-intake</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__AKB2_REPO_ROOT__/scripts/akb2-loop2-intake.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__AKB2_REPO_ROOT__</string>

    <key>StartInterval</key>
    <integer>14400</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__AKB2_REPO_ROOT__/logs/loop2-intake.log</string>

    <key>StandardErrorPath</key>
    <string>__AKB2_REPO_ROOT__/logs/loop2-intake.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>__AKB2_REPO_ROOT__/src</string>
        <key>PATH</key>
        <string>__AKB2_HOME__/.pyenv/shims:__AKB2_HOME__/.pyenv/bin:__AKB2_HOME__/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>AKB2_VAULT_ROOT</key>
        <string>__AKB2_VAULT_ROOT__/Praise Space/AKB2.0</string>
    </dict>
</dict>
</plist>
