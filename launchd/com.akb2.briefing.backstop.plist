<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.akb2.briefing.backstop</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/praise/AI-Agent/Claude/projects/Project AKB2/scripts/briefing_backstop.sh</string>
        <string>--vault-root</string>
        <string>/Volumes/AKB2/Obsidian</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/praise/AI-Agent/Claude/projects/Project AKB2/</string>
    <!-- 结构性说明（2026-07-30）：下面第二个时段 12:05 晚于脚本默认 deadline 12:00，
         该时段调用按设计只能巡检报告、无法真正补跑；当日简报已 pass 时 exit 0(skip)，
         未达 pass 时照实 FAILED + exit 124。若要让第二次调用真能补跑，需人工决定是
         把时段提前到 deadline 之前，还是把 deadline 往后放 —— 不由 agent 私改调度。 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>5</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/praise/AI-Agent/Claude/projects/Project AKB2/logs/backstop-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/praise/AI-Agent/Claude/projects/Project AKB2/logs/backstop-stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/praise/AI-Agent/Claude/projects/Project AKB2/src</string>
        <key>PATH</key>
        <string>/Users/praise/.pyenv/shims:/Users/praise/.pyenv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>AKB2_TRANSLATE_TIMEOUT</key>
        <string>300</string>
    </dict>
</dict>
</plist>
